{
    "version":  "2.0.0",
    "tasks":  [
                  {
                      "label":  "Build JoyRide APK",
                      "type":  "process",
                      "command":  "C:\\Program Files\\nodejs\\npx.cmd",
                      "args":  [
                                   "--yes",
                                   "eas-cli@latest",
                                   "build",
                                   "--platform",
                                   "android",
                                   "--profile",
                                   "preview"
                               ],
                      "options":  {
                                      "cwd":  "${workspaceFolder}\\frontend"
                                  },
                      "problemMatcher":  [

                                         ],
                      "group":  {
                                    "kind":  "build",
                                    "isDefault":  true
                                }
                  },
                  {
                      "label":  "JoyRide: Backend",
                      "type":  "process",
                      "command":  "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe",
                      "args":  [
                                   "-m",
                                   "uvicorn",
                                   "server:app",
                                   "--host",
                                   "0.0.0.0",
                                   "--port",
                                   "8002"
                               ],
                      "options":  {
                                      "cwd":  "${workspaceFolder}\\backend"
                                  },
                      "problemMatcher":  [

                                         ]
                  },
                  {
                      "label":  "JoyRide: Phone app (Expo Go)",
                      "type":  "process",
                      "command":  "corepack",
                      "args":  [
                                   "yarn",
                                   "start",
                                   "--lan",
                                   "--port",
                                   "8082"
                               ],
                      "options":  {
                                      "cwd":  "${workspaceFolder}\\frontend"
                                  },
                      "problemMatcher":  [

                                         ]
                  }
              ]
}
